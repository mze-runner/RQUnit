{
  "id": "order-lifecycle",
  "kind": "statechart",
  "initial": "placed",
  "undeclared_event_policy": "error",
  "vocabulary": {
    "CANCEL": "{endpoint:cancel_order}",
    "REFUND_SETTLED": "{message:refund_settled}",
    "DELIVERY_REPORTED": "{endpoint:record_delivery}",
    "SHIP": "internal",
    "RETRY": "internal",
    "RETURN": "internal"
  },
  "states": {
    "placed": {
      "invariant": "total_is_server_derived",
      "on": { "CANCEL": "cancelling", "SHIP": "shipped" }
    },
    "cancelling": {
      "invariant": "no_new_picks_dispatched",
      "on": { "REFUND_SETTLED": "cancelled" }
    },
    "shipped": {
      "on": { "DELIVERY_REPORTED": "delivered", "RETRY": "delivery_attempted" }
    },
    "delivery_attempted": {
      "invariant": "attempt_count_recorded",
      "on": { "DELIVERY_REPORTED": "delivered", "RETRY": "delivery_attempted", "RETURN": "returned" }
    },
    "delivered": {
      "invariant": "proof_of_delivery_retained",
      "type": "final"
    },
    "cancelled": { "type": "final" },
    "returned": { "type": "final" }
  }
}
